# ==========================================
# ERP Production Environment Variables
# Location on VPS: /var/www/erp/backend/.env
# ==========================================

# 1. Django Core Security
DEBUG=False
SECRET_KEY=generate-a-strong-random-secret-key-here-with-openssl-rand-hex-32

# 2. Allowed Hosts (Comma-separated: your domain, VPS public IP, localhost)
ALLOWED_HOSTS=erp.arabseason.info,api.arabseason.info,127.0.0.1,localhost,YOUR_VPS_IP

# 3. Database URL
# For PostgreSQL (Recommended on KVM 4):
DATABASE_URL=postgres://erp_user:YOUR_STRONG_PASSWORD@localhost:5432/erp_db

# (Alternative) If starting with SQLite:
# DATABASE_URL=sqlite:////var/www/erp/backend/db.sqlite3

# 4. CORS & CSRF Settings
CORS_ALLOWED_ORIGINS=https://erp.arabseason.info,https://arabseason.info,https://api.arabseason.info
CSRF_TRUSTED_ORIGINS=https://erp.arabseason.info,https://arabseason.info,https://api.arabseason.info

